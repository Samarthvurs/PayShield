# Copy to .env and change the secrets. .env is git-ignored.

# "dev" enables the dashboard's demo button and test-card list. Use "prod" to turn them off.
APP_ENV=dev

# Hostnames "postgres" and "mongo" are the Docker Compose service names.
DATABASE_URL=postgresql+psycopg://payshield:payshield@postgres:5432/payshield
MONGO_URL=mongodb://mongo:27017
MONGO_DB=payshield

# Secret used to turn card numbers into tokens (HMAC-SHA256). Long and random.
CARD_TOKEN_SECRET=change-me-to-a-long-random-string

# Clients must send this in the X-API-Key header to create payments.
API_KEY=change-me-api-key

# Optional: real AI explanations. Leave empty to use the built-in fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
